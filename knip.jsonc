{
  "$schema": "https://unpkg.com/knip@6.31.0/schema.json",
  // Code-diet baseline (#1410).
  //
  // Keep structural debt visible as warnings while failing on new dependency
  // drift, unresolved imports, and undeclared OS command usage. Runtime and
  // packaging dependencies below are loaded through Electron, esbuild externals,
  // package scripts, or optional guarded require() calls that Knip cannot infer.
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error"
  },
  "workspaces": {
    ".": {
      // Electron-hosted entry points. `smoke:llm` / `smoke:app` launch these
      // with the electron binary rather than importing them, so Knip cannot
      // infer the reference and reports both as unused files.
      //
      // The git hook chain is an entry point for the same reason:
      // `.git/hooks/pre-commit` and `pre-push` EXECUTE run-local-checks.mjs,
      // nothing imports it. Without this, every export reachable only from
      // there is invisible to Knip — so a dead export under scripts/hooks/
      // could never be reported, and seven of them had accumulated.
      "entry": [
        // Standalone Node command emitted by build:main and invoked by the native launcher.
        "src/headless.ts",
        // Executed as a separate managed child, not imported into the host loop.
        "src/tools/image-preparation-child.ts",
        "scripts/smoke-live-model.mjs",
        "scripts/smoke-live-app.mjs",
        // Loaded by the installer packager through build.beforePack.
        "scripts/electron-before-pack.cjs",
        "scripts/hooks/run-local-checks.mjs",
        // Launched by the release builder after schema generation.
        "scripts/sync-plugin-host-protocol-mirror.mjs",
        // Types-only assertions compiled by `typecheck`; nothing imports them.
        "scripts/lib/plugin-isolation-type-assertions.ts",
        // Types-only equalities between the generated protocol client and the
        // host. `check:plugin-host-protocol-client` compiles it as its own
        // program and `typecheck` compiles it with the rest of scripts/;
        // nothing imports it.
        "scripts/lib/plugin-host-protocol-client-assertions.ts",
        // The generated protocol client is a published artifact: plugin
        // repositories vendor it, so every export is public API even where
        // nothing in this repository imports it.
        "schemas/plugin-host-protocol/*/protocol-client.ts",
        // Loaded through the local @ave/shell-parser-runtime package exports.
        "resources/shell-parser/wasm_exec.cjs",
        // Explicit parser rebuild entry documented in tools/shell-parser/README.md.
        "tools/shell-parser/build.mjs",
        // Plugin modules the host-protocol golden harness hands the child runtime
        // BY PATH, which imports them through `importPluginFactory` as it imports
        // an installed plugin's entry — nothing names them in an import.
        "src/plugins/isolation/__tests__/fixtures/host-protocol/*/**/*.mjs"
      ]
    },
    "web": {
      // The nested web workspace owns a separate lockfile/install. Root Knip
      // still analyzes its sources and dependency declarations without
      // requiring web/node_modules to exist in desktop-app workflows.
      "ignoreBinaries": ["next"]
    }
  },
  "vitest": {
    "config": "vitest.analysis.config.ts"
  },
  // The declaration supplies test TypeScript types for a Node test helper.
  // The runtime import names its .mjs sibling, so the file graph misses it.
  "ignoreFiles": ["src/__tests__/support/git-fixture-env.d.mts"],
  "ignoreDependencies": [
    // Invoked as a BINARY from an argv array the pre-push hook builds at runtime
    // (`bun x electron-rebuild -f --only better-sqlite3`, scripts/hooks/run-local-checks.mjs),
    // so no package.json script names it and Knip cannot infer the reference.
    // It is the only Electron-ABI repair path left now that `postinstall` no
    // longer rebuilds native modules.
    "@electron/rebuild",
    "@openai/codex",
    "@sentry/electron",
    "@types/better-sqlite3",
    "better-sqlite3",
    "electron-builder",
    "electron-updater",
    "pino-pretty",
    "shadcn"
  ],
  "ignoreBinaries": [
    // The system C compiler that builds the confined-child preload library.
    "cc",
    // External Go toolchain for the explicit parser rebuild, pinned by go.mod.
    "go",
    // Windows ACL inspection from the ave-home privacy regression.
    "icacls",
    "lsof",
    "mountvol",
    "mkfifo",
    "pgrep",
    "plutil",
    "powershell.exe",
    "python3",
    "subst",
    "taskkill",
    "where"
  ],
  // knip 6.29 resolves absolute-path spawn targets as module specifiers and
  // reports them as `unresolved`. `/usr/bin/codesign` is the canonical macOS
  // system binary (auto-updater Developer-ID probe) — absolute by design to
  // avoid PATH interposition — so it is intentionally external, not a missing
  // import. Matched as a regex against the unresolved specifier.
  "ignoreUnresolved": ["/usr/bin/codesign"]
}
