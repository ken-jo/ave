+
+// WorkLimits bounds actual lexer advances and actual argv word records. Zero
+// disables the corresponding permission-specific bound for general parsing.
+func WorkLimits(lexerSteps, commandWords int) ParserOption {
+	return func(p *Parser) {
+		p.lexerWorkLimit = lexerSteps
+		p.commandWordsLimit = commandWords
+	}
+}
+
+func (p *Parser) LexerWork() int { return p.lexerWork }
+
+func (p *Parser) lexerStep() bool {
+	p.lexerWork++
+	if p.lexerWorkLimit > 0 && p.lexerWork > p.lexerWorkLimit {
+		p.curErr("shell lexer work limit exceeded")
+		return false
+	}
+	return p.err == nil
+}
