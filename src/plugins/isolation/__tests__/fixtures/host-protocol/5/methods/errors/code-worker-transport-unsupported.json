{
  "request": {
    "id": 1,
    "jsonrpc": "2.0",
    "method": "ave/host/spawnWorker",
    "params": {
      "_meta": {
        "ave/invocation": "<uuid-1>"
      },
      "spec": {
        "args": [
          "--version"
        ],
        "command": "/usr/bin/true",
        "control": "stdio-control-v1",
        "workerId": "golden"
      }
    }
  },
  "response": {
    "error": {
      "code": -32000,
      "data": {
        "code": "worker-transport-unsupported",
        "name": "WorkerTransportUnsupportedError"
      },
      "message": "이 익스텐션의 워커는 Windows 익스텐션 컨테이너가 지원하지 않는 연결 방식을 씁니다. 워커에는 stdio control v1 이 필요하니 익스텐션을 업데이트하세요(worker-transport-unsupported)"
    },
    "id": 1,
    "jsonrpc": "2.0"
  },
  "trigger": "a container backend that cannot carry the worker"
}
