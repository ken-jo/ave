{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sampleassistant",
  "version": "0.11.3",
  "description": "Host protocol golden fixture: the hostApi surface the sampleassistant plugin reaches, beside its own lifecycle and access declarations.",
  "extensions": {
    "ai.agent-connector.ave": {
      "displayName": "Sample Assistant",
      "entry": "entry.mjs",
      "capabilities": [
        "host:overlay",
        "lifecycle-observer"
      ],
      "pluginAccess": {
        "plugins": [
          {
            "pluginId": "samplemail"
          },
          {
            "pluginId": "meeting"
          },
          {
            "pluginId": "sampleportal"
          }
        ]
      },
      "dependencies": [
        {
          "pluginId": "samplemail",
          "required": false
        },
        {
          "pluginId": "meeting",
          "required": false
        },
        {
          "pluginId": "sampleportal",
          "required": false
        }
      ],
      "requires": {
        "minAppVersion": "0.14.0",
        "hostProtocol": "5"
      },
      "configSchema": {
        "properties": {
          "osNotificationsEnabled": {
            "type": "boolean",
            "title": "OS notifications",
            "default": true
          }
        }
      },
      "tools": [
        {
          "name": "exercise_host",
          "description": "Call each hostApi member this surface uses, once.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "report_host",
          "description": "Report what the host pushed since, and release what is held.",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        }
      ]
    }
  }
}
