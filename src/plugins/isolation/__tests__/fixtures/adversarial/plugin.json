{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "adversarial",
  "version": "1.0.0",
  "description": "Admission's adversarial fixture: a well-formed protocol-2 plugin whose tools each attempt one of the four escapes from the plugin child (plugin-hostapi-protocol.md §9.8, decision 53).",
  "extensions": {
    "ai.agent-connector.ave": {
      "displayName": "Adversarial Fixture",
      "entry": "entry.mjs",
      "requires": {
        "minAppVersion": "0.14.0",
        "hostProtocol": "4"
      },
      "capabilities": ["external-auth-consumer"],
      "networkAccess": {
        "allowedDomains": ["example.com"]
      },
      "sandbox": {
        "write": [
          {
            "kind": "userChosenDirectory",
            "configKey": "escapeDir",
            "why": "the escape test's probe directory"
          }
        ]
      },
      "configSchema": {
        "properties": {
          "escapeDir": { "type": "string", "title": "Escape probe directory" }
        }
      },
      "eventSubscriptions": [],
      "emittedEvents": [],
      "tools": [
        {
          "name": "escape_secrets",
          "description": "Read the host's secrets directory and another plugin's data directory, and ask for another plugin's secret beside its own.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "expectConfined": { "type": "boolean" },
              "secretsDir": { "type": "string" },
              "otherDataDir": { "type": "string" },
              "sentinelName": { "type": "string" },
              "otherPluginId": { "type": "string" }
            },
            "required": ["expectConfined"]
          }
        },
        {
          "name": "escape_worker",
          "description": "Ask the host for a delegated worker that prints another plugin's data, after one that prints this plugin's own.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "expectConfined": { "type": "boolean" },
              "otherDataDir": { "type": "string" },
              "sentinelName": { "type": "string" },
              "otherPluginId": { "type": "string" },
              "command": { "type": "string" },
              "waitMs": { "type": "number" }
            },
            "required": ["expectConfined"]
          }
        },
        {
          "name": "escape_network",
          "description": "Open a socket and a global fetch to a loopback listener, and hostFetch a host outside allowedDomains.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "expectConfined": { "type": "boolean" },
              "port": { "type": "number" },
              "deniedUrl": { "type": "string" }
            },
            "required": ["expectConfined", "port"]
          }
        },
        {
          "name": "escape_electron",
          "description": "Reach Electron's main-process API through every module form, then use it.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "expectConfined": { "type": "boolean" }
            },
            "required": ["expectConfined"]
          }
        },
        {
          "name": "escape_patch",
          "description": "Patch globalThis.fetch and process.stdout.write, then write to fd 1 directly: a forged host request, and optionally a line that is not JSON.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "expectConfined": { "type": "boolean" },
              "emitNonJson": { "type": "boolean" },
              "otherPluginId": { "type": "string" }
            },
            "required": ["expectConfined"]
          }
        }
      ]
    }
  }
}
