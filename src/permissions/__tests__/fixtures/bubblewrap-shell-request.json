{
  "version": "0.9.0-alpha",
  "containment": "bubblewrap",
  "process": {
    "commandLine": "'/app/filter/apply-seccomp' --close-other-fds --keep-fd 9 -- /bin/sh -c '. /dev/fd/9 && exec 9<&- || exit 125\nexport NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1\nprintf '\"'\"'%s'\"'\"' control'",
    "cwd": "/work",
    "timeout": 3000,
    "inheritDefaultEnv": false,
    "env": []
  },
  "filesystem": {
    "readwritePaths": [
      "/work",
      "/work/.ave"
    ],
    "readonlyPaths": [
      "/usr",
      "/tmp",
      "/app/filter"
    ],
    "deniedPaths": [
      "/work/.ave/hooks"
    ]
  },
  "network": {
    "egress": {
      "default": "deny"
    },
    "ingress": {
      "default": "deny",
      "hostLoopback": "deny"
    }
  },
  "runtimeConfig": {
    "networkProxy": "http://127.0.0.1:12345"
  }
}
