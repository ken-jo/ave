# The app reads its service descriptor and the announcements it names. A short
# cache lets an announcement or a domain move reach clients within minutes.
/.well-known/ave-service.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff

/announcements/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
