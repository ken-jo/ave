# The app reads these files (app design §11). Ave fetches ave-service.json; older
# Ave installs still fetch former-service.json, so both stay published with the same
# body. A short cache lets an announcement or a domain move reach clients within minutes.
/.well-known/ave-service.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff

/.well-known/former-service.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff

/announcements/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
