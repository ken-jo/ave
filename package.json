{
  "name": "ave",
  "version": "0.14.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "aveRelease": {
    "tagDistribution": "public",
    "signing": "unsigned"
  },
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "description": "Ave, a comprehensive agent browser: you, your agents, your models and your computer in one desktop app with browser, terminal, chat, plugins and skills.",
  "keywords": [
    "ave",
    "electron",
    "desktop-agent",
    "ai-agent",
    "plugin-runtime",
    "marketplace",
    "local-indexing",
    "meetings"
  ],
  "homepage": "https://github.com/ken-jo/ave",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken-jo/ave.git"
  },
  "author": {
    "name": "Ken Jo",
    "email": "jo.dreame@gmail.com"
  },
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/restore-node-pty-exec-bit.mjs && node scripts/fetch-uv.mjs && node scripts/fetch-mxc.mjs --current && node scripts/hooks/install.mjs",
    "build:main": "node scripts/build-main-esbuild.mjs",
    "build:webpack": "node --import ./scripts/lib/document-consumer-guard.mjs ./node_modules/webpack/bin/webpack.js --config webpack.config.cjs",
    "build:renderer": "node --import ./scripts/lib/document-consumer-guard.mjs ./node_modules/webpack/bin/webpack.js --config webpack.config.cjs --config-name renderer",
    "build:styles": "tailwindcss --input src/styles.css --output dist/src/styles.css --minify",
    "build:preload": "node --import ./scripts/lib/document-consumer-guard.mjs ./node_modules/webpack/bin/webpack.js --config webpack.config.cjs --config-name preload",
    "build:plugin-preload": "webpack --config webpack.config.cjs --config-name pluginPreload",
    "build:floating-dock-preload": "webpack --config webpack.config.cjs --config-name floatingDockPreload",
    "build:icons": "node scripts/generate-ave-icons.cjs",
    "build": "bun run check:import-cycles && node scripts/clean-dist.mjs && bun run build:icons && node scripts/check-generated-assets.mjs && bun run check:plugin-host-protocol-schema && bun run check:plugin-host-protocol-mirror && bun run check:plugin-host-protocol-client && bun run build:main && bun run check:i18n-catalog && bun run check:i18n-barrels && bun run build:webpack && bun run build:styles && node scripts/copy-build-assets.mjs && node scripts/check-no-tls-bypass.mjs && node scripts/check-opacity-tokens.mjs && node scripts/check-color-tokens.mjs && node scripts/check-shell-geometry-tokens.mjs && node scripts/check-no-inline-channels.mjs && node scripts/check-sandboxed-preloads.mjs && bun run check:source-text-safe",
    "typecheck": "tsc --noEmit",
    "start": "bun run build && node scripts/run-electron.mjs dist/src/main/main.js",
    "dev": "node scripts/run-electron-dev.mjs",
    "plugins:list": "tsx scripts/plugins-cli.ts list",
    "cli": "tsx scripts/ave-cli.ts",
    "test:prepare": "bun run build:icons && node scripts/prepare-windows-job.mjs",
    "test:vitest": "node scripts/run-vitest-under-electron.mjs",
    "test": "bun run test:prepare && bun run test:vitest -- run",
    "test:a2a": "bun run check:a2a-p4-5-contract && bun run test:prepare && bun run test:vitest -- run a2a subagent parent-child-directive agent-send",
    "plugin:validate": "node --import tsx --import ./scripts/lib/stub-app-logger-hook.mjs src/plugins/validate/cli.ts --child-entry src/plugins/isolation/plugin-child-main.ts --child-exec-arg=--import --child-exec-arg=tsx --child-exec-arg=--import --child-exec-arg=./scripts/lib/stub-app-logger-hook.mjs",
    "check:i18n-catalog": "node --import tsx scripts/i18n-validate-catalog.ts",
    "check:plugin-host-protocol-schema": "node --import tsx scripts/generate-plugin-host-protocol-schema.ts --check",
    "check:plugin-host-protocol-mirror": "node scripts/check-plugin-host-protocol-mirror.mjs",
    "check:plugin-host-protocol-client": "node --import tsx scripts/generate-plugin-host-protocol-client.ts --check",
    "generate:plugin-host-protocol-schema": "node --import tsx scripts/generate-plugin-host-protocol-schema.ts",
    "generate:plugin-host-protocol-client": "node --import tsx scripts/generate-plugin-host-protocol-client.ts",
    "generate:model-catalog": "node --import tsx scripts/generate-model-catalog.ts",
    "check:model-catalog": "node --import tsx scripts/generate-model-catalog.ts --check",
    "check:i18n-barrels": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/i18n-catalog-barrels.test.mjs && node scripts/check-i18n-catalog-barrels.mjs",
    "check:sunset-inventory": "node scripts/check-sunset-inventory.mjs",
    "check:import-cycles": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/import-cycle-check.test.mjs && node scripts/check-import-cycles.mjs src",
    "check:a2a-p4-5-contract": "node scripts/check-a2a-p4-5-contract.mjs",
    "test:knip-gate": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/knip-baseline.test.mjs && node scripts/check-knip-gate-self-test.mjs",
    "check:shell-geometry-tokens": "node scripts/check-shell-geometry-tokens.mjs",
    "check:no-inline-channels": "node scripts/check-no-inline-channels.mjs",
    "check:sandboxed-preloads": "node scripts/check-sandboxed-preloads.mjs",
    "check:env-surface": "node --import tsx scripts/check-env-surface-policy.ts",
    "check:source-text-safe": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/source-text-safe.test.mjs && node scripts/check-source-text-safe.mjs",
    "check:knip": "node scripts/check-knip-baseline.mjs",
    "check:knip:engine": "knip --config config/knip.jsonc --reporter json",
    "check:knip:self-test": "node scripts/check-knip-gate-self-test.mjs",
    "check:knip:update": "node scripts/check-knip-baseline.mjs --update-baseline",
    "check:typecheck-tests": "node scripts/check-test-typecheck-baseline.mjs",
    "check:typecheck-tests:self-test": "node scripts/check-test-typecheck-gate-self-test.mjs",
    "check:typecheck-tests:update": "node scripts/check-test-typecheck-baseline.mjs --update-baseline",
    "check:test-duplicates": "node scripts/check-test-duplicates.mjs",
    "check:sot-shapes": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/check-sot-shapes.test.mjs && node scripts/check-sot-shapes.mjs",
    "check:asrt-claims": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/check-asrt-version-claims.test.mjs && node scripts/check-asrt-version-claims.mjs",
    "check:safestorage-sync": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/check-safestorage-sync.test.mjs && node scripts/check-safestorage-sync.mjs",
    "check:retired-name": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/retired-name.test.mjs && node scripts/check-retired-name.mjs",
    "check:sot-shapes:update": "node scripts/check-sot-shapes.mjs --update-baseline",
    "check:gate-core": "bun run check:knip && bun run check:test-duplicates -- --fail-on-duplicates && bun run check:sunset-inventory && bun run check:sot-shapes && bun run check:asrt-claims && bun run check:safestorage-sync && bun run check:retired-name && bun run check:a2a-p4-5-contract && bun run check:model-catalog",
    "test:coverage": "bun run test:prepare && bun run test:vitest -- run --coverage",
    "check:test-coverage": "node scripts/run-test-coverage-gate.mjs",
    "test:ci": "node scripts/run-ci-suite.mjs",
    "check:test-quality": "bun run check:test-duplicates -- --fail-on-duplicates && bun run check:test-coverage",
    "test:watch": "bun run test:prepare && bun run test:vitest",
    "test:ui-e2e": "playwright test --config config/playwright.config.ts",
    "smoke:llm": "electron scripts/smoke-live-model.mjs",
    "smoke:app": "electron scripts/smoke-live-app.mjs",
    "test:electron-smoke": "node scripts/run-electron.mjs --version",
    "test:packaged-smoke": "node scripts/smoke-packaged-app.mjs --target current",
    "test:main-flow": "tsx scripts/test-main-flow.ts",
    "test:headless:build": "node --import ./scripts/lib/document-consumer-guard.mjs --test test/scripts/headless-bundle-boundary.test.mjs test/scripts/headless-launch-options.test.mjs test/scripts/build-source-identity.test.mjs",
    "test:headless:runtime": "node scripts/headless-runtime-smoke.mjs",
    "test:headless:process": "node scripts/headless-process-smoke.mjs",
    "dist": "node scripts/build-installers.mjs --current",
    "dist:current": "node scripts/build-installers.mjs --current",
    "dist:mac": "node scripts/build-installers.mjs --mac",
    "dist:linux": "node scripts/build-installers.mjs --linux",
    "dist:headless": "node scripts/package-headless-runtime.mjs",
    "dist:win": "node scripts/build-installers.mjs --win",
    "dist:fast": "node scripts/build-installers.mjs --current --fast",
    "dist:mac:fast": "node scripts/build-installers.mjs --mac --fast",
    "dist:linux:fast": "node scripts/build-installers.mjs --linux --fast",
    "dist:win:fast": "node scripts/build-installers.mjs --win --fast",
    "release": "node scripts/release.mjs",
    "build:windows-job": "node scripts/build-windows-job.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "~4.0.87",
    "@ai-sdk/azure": "^4.0.109",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/google-vertex": "^5.0.121",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "~3.0.77",
    "@ai-sdk/otel": "^1.0.150",
    "@anthropic-ai/sandbox-runtime": "0.0.80",
    "@ave/shell-parser-runtime": "file:resources/shell-parser",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.0.13",
    "@nodable/entities": "3.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@vscode/ripgrep": "1.18.0",
    "adm-zip": "^0.6.1",
    "ai": "~7.0.150",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "electron-audio-loopback": "^1.0.6",
    "electron-updater": "~6.8.11",
    "fast-xml-parser": "5.11.2",
    "jose": "6.2.3",
    "jszip": "3.10.2",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.4.299",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "0.35.5",
    "sonic-boom": "^5.0.2",
    "tar": "7.5.22",
    "tldts": "7.0.30",
    "undici": "^8.12.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.53",
    "@electron/asar": "4.3.1",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/adm-zip": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "app-builder-lib": "26.18.0",
    "baseline-browser-mapping": "^2.11.31",
    "caniuse-lite": "^1.0.30001819",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "eruda": "^3.4.3",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "highlight.js": "11.11.2",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "knip": "6.42.1",
    "lowlight": "3.3.0",
    "lucide-react": "^1.61.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-data-grid": "7.0.0-beta.61",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.1",
    "webpack-cli": "^7.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "esbuild",
    "node-pty"
  ],
  "build": {
    "appId": "ai.agent-connector.ave",
    "productName": "Ave",
    "copyright": "Copyright © 2026 Ken Jo",
    "icon": "build/icon.png",
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "scripts/electron-after-pack.cjs",
    "afterSign": "scripts/electron-after-sign.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!dist/src/components{,/**/*}",
      "!dist/src/ui{,/**/*}",
      "!dist/**/{__tests__,__probes__,test,tests,fixtures}{,/**/*}",
      "!dist/**/*.{test,spec}.{js,cjs,mjs}",
      "!dist/scripts/**/*.js",
      "!node_modules/*/{docs,doc,test,tests,__tests__,example,examples,benchmark,benchmarks,coverage}{,/**/*}",
      "!node_modules/@*/*/{docs,doc,test,tests,__tests__,example,examples,benchmark,benchmarks,coverage}{,/**/*}",
      "!node_modules/**/{browser-test,system-test,*-test,test-*}{,/**/*}",
      "!node_modules/better-sqlite3/deps{,/**/*}",
      "!node_modules/better-sqlite3/src{,/**/*}",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/{prebuild-install,napi-build-utils,node-abi}{,/**/*}",
      "!node_modules/{ai,zod,undici,adm-zip,proper-lockfile,papaparse,xlsx,jszip,fast-xml-parser}{,/**/*}",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types}{,/**/*}",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}{,/**/*}",
      "!node_modules/pdfjs-dist/legacy/build/{pdf.min.mjs,pdf.worker.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs}",
      "!node_modules/@nodable/entities{,/**/*}",
      "!node_modules/pdfjs-dist/wasm/{quickjs-eval.js,quickjs-eval.wasm,jbig2_nowasm_fallback.js,openjpeg_nowasm_fallback.js}",
      "!node_modules/@ai-sdk{,/**/*}",
      "!node_modules/@azure/msal-*{,/**/*}",
      "!node_modules/@radix-ui{,/**/*}",
      "!node_modules/{class-variance-authority,clsx,cmdk,date-fns,eruda,lucide-react,mermaid,radix-ui,react,react-day-picker,react-dom,react-markdown,remark-gfm,shadcn,tailwind-merge,tw-animate-css}{,/**/*}",
      "!node_modules/@xterm{,/**/*}",
      "!node_modules/**/*.{test,spec}.{js,cjs,mjs}",
      "!node_modules/**/{.github,.vscode,.idea}{,/**/*}",
      "!node_modules/**/*.{map,ts,tsx,mts,cts,md,markdown}",
      "!node_modules/**/tsconfig*.json",
      "!resources/uv{,/**/*}",
      "!resources/uv-runtime{,/**/*}"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/sandbox-runtime/vendor/**",
      "node_modules/@vscode/ripgrep*/**",
      "node_modules/node-pty/**",
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@napi-rs/**",
      "node_modules/pdfjs-dist/{standard_fonts,cmaps,iccs,wasm}/**",
      "node_modules/@img/**"
    ],
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Ave URL",
        "schemes": [
          "ave"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.agent-connector.ai/releases",
        "channel": "latest",
        "useMultipleRangeRequest": false
      }
    ],
    "extraResources": [
      {
        "from": "resources/licenses/document-preview",
        "to": "licenses/document-preview"
      },
      {
        "from": "resources/licenses/canvas",
        "to": "licenses/canvas"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/tray-icon@2x.png",
        "to": "tray-icon@2x.png"
      },
      {
        "from": "build/tray-iconTemplate.png",
        "to": "tray-iconTemplate.png"
      },
      {
        "from": "build/tray-iconTemplate@2x.png",
        "to": "tray-iconTemplate@2x.png"
      },
      {
        "from": "resources/uv-runtime",
        "to": "uv"
      },
      {
        "from": "resources/licenses/uv",
        "to": "licenses/uv"
      },
      {
        "from": "resources/licenses/models.dev",
        "to": "licenses/models.dev"
      },
      {
        "from": "resources/licenses/ripgrep",
        "to": "licenses/ripgrep"
      },
      {
        "from": "resources/AGENTS.md",
        "to": "AGENTS.md"
      },
      {
        "from": "resources/AGENTS.md.replaceable-sha256",
        "to": "AGENTS.md.replaceable-sha256"
      },
      {
        "from": "resources/agents",
        "to": "agents",
        "filter": [
          "*.md"
        ]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "dist/skill-scripts",
        "to": "skill-scripts",
        "filter": ["*.cjs", "manifest.json"]
      },
      {
        "from": "resources/prompts",
        "to": "prompts",
        "filter": [
          "*.md"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 280
      },
      "contents": [
        {
          "x": 140,
          "y": 130,
          "type": "file"
        },
        {
          "x": 400,
          "y": 130,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "category": "Office",
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "rpm": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib"
      ]
    },
    "win": {
      "signExts": ["!srt-win.exe"],
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "resources/windows-job/${arch}/ave-job.exe",
          "to": "windows-job/${arch}/ave-job.exe"
        },
        {
          "from": "resources/windows-path-kind/${arch}/ave-path-kind.exe",
          "to": "windows-path-kind/${arch}/ave-path-kind.exe"
        },
        {
          "from": "resources/mxc/${arch}/wxc-exec.exe",
          "to": "mxc/${arch}/wxc-exec.exe"
        },
        {
          "from": "resources/licenses/mxc",
          "to": "licenses/mxc"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "differentialPackage": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/installerIcon.ico",
