# .env.demo.example — corporate internal demo credentials template
#
# Copy this file to .env.demo (gitignored) and fill in the real values.
# scripts/run-electron.mjs loads .env.demo automatically on `bun run start`
# so you do NOT need to `source` it manually.
#
# NEVER commit .env.demo — it contains an corporate-issued API key.

# Vendor the Login chip activates. azure-foundry is the corporate intranet demo target.
AVE_DEMO_VENDOR=azure-foundry

# Azure AI Foundry credentials (corporate-issued — obtain from the demo owner)
AVE_DEMO_KEY_AZURE_FOUNDRY=<paste-api-key-here>
AVE_DEMO_BASEURL_AZURE_FOUNDRY=https://aif-example.openai.azure.com/openai/v1/
AVE_DEMO_MODEL_AZURE_FOUNDRY=gpt-4o

# Host resolver — maps Azure Foundry hostnames to corporate intranet IPs inside
# Electron only (no /etc/hosts mutation). Required when running on the corporate
# intranet. Leave blank or omit if your machine can resolve these via DNS.
AVE_DEMO_HOST_MAP=aif-example.cognitiveservices.azure.com=10.0.100.174,aif-example.openai.azure.com=10.0.100.175,aif-example.services.ai.azure.com=10.0.100.176
