{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ave.agent-connector.ai/schemas/marketplace/2/revocations-by-app.schema.json",
  "title": "Ave app-conditional source revocations",
  "description": "Revocations a source publishes for its own packages (design §10.4). They apply only to installs from the same source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revocations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "revocations": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "versions",
          "reason",
          "at",
          "action",
          "appVersions",
          "successors"
        ],
        "properties": {
          "kind": {
            "$ref": "package.schema.json#/definitions/kind"
          },
          "name": {
            "$ref": "package.schema.json#/definitions/packageName"
          },
          "versions": {
            "description": "A version range: comparators (>=, >, <=, <, =, or a bare version) joined by spaces, alternatives joined by ||, or * for every version.",
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "enum": [
              "disable",
              "uninstall"
            ]
          },
          "appVersions": {
            "$ref": "package.schema.json#/definitions/minAppVersion"
          },
          "successors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plugins",
              "hostKinds"
            ],
            "properties": {
              "plugins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pluginId"
                  ],
                  "properties": {
                    "pluginId": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "constructor",
                          "prototype"
                        ]
                      }
                    },
                    "anySource": {
                      "const": true
                    }
                  }
                }
              },
              "hostKinds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "enabled"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^@host:(?!.*--)[a-z][a-z0-9-]{0,30}[a-z0-9]$"
                    },
                    "enabled": {
                      "$ref": "#/definitions/inheritRule"
                    },
                    "osNotification": {
                      "$ref": "#/definitions/inheritRule"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "inheritRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "listed",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "listed": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "masterKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        }
      }
    }
  }
}
