{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdk.former-site.invalid/schemas/marketplace/index.2.schema.json",
  "title": "Ave marketplace index (marketplace.json)",
  "description": "The root index of a marketplace repository (design §4). Unknown keys are rejected. The app validates the root and each package entry separately: an invalid root rejects the commit, an invalid package entry drops that package with a diagnostic.",
  "allOf": [
    {
      "$ref": "#/definitions/indexRoot"
    },
    {
      "properties": {
        "packages": {
          "items": {
            "$ref": "#/definitions/indexPackage"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  ],
  "definitions": {
    "indexRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "name",
        "displayName",
        "packages"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 2
        },
        "name": {
          "$ref": "package.2.schema.json#/definitions/sourceId"
        },
        "displayName": {
          "$ref": "package.2.schema.json#/definitions/label"
        },
        "description": {
          "$ref": "package.2.schema.json#/definitions/description"
        },
        "owner": {
          "$ref": "package.2.schema.json#/definitions/person"
        },
        "packages": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "indexPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "path"
      ],
      "properties": {
        "kind": {
          "$ref": "package.2.schema.json#/definitions/kind"
        },
        "name": {
          "$ref": "package.2.schema.json#/definitions/packageName"
        },
        "path": {
          "$ref": "package.2.schema.json#/definitions/repoPath"
        },
        "displayName": {
          "$ref": "package.2.schema.json#/definitions/label"
        },
        "description": {
          "$ref": "package.2.schema.json#/definitions/description"
        },
        "keywords": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "icon": {
          "$ref": "package.2.schema.json#/definitions/iconPath"
        },
        "latest": {
          "$ref": "package.2.schema.json#/definitions/semver"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/definitions/indexVersion"
          }
        }
      }
    },
    "indexVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "minAppVersion",
        "publishedAt"
      ],
      "properties": {
        "version": {
          "$ref": "package.2.schema.json#/definitions/semver"
        },
        "commit": {
          "$ref": "package.2.schema.json#/definitions/commit"
        },
        "minAppVersion": {
          "$ref": "package.2.schema.json#/definitions/minAppVersion"
        },
        "platforms": {
          "$ref": "package.2.schema.json#/definitions/platforms"
        },
        "authority": {
          "$ref": "package.2.schema.json#/definitions/pluginAuthority"
        },
        "artifact": {
          "$ref": "package.2.schema.json#/definitions/pluginArtifactPins"
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percent"
          ],
          "properties": {
            "percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "yanked": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "at"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "hostProtocol": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    }
  }
}
