{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdk.former-site.invalid/schemas/marketplace/package.schema.json",
  "title": "Ave package descriptor (ave-package.json)",
  "description": "One installable package (design §5). The plugin authority fields reference the plugin manifest schema, so a descriptor and the plugin.json it copies are checked by the same definitions.",
  "allOf": [
    {
      "$ref": "#/definitions/descriptor"
    }
  ],
  "definitions": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "name",
        "version",
        "minAppVersion",
        "payload"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 2
        },
        "kind": {
          "$ref": "#/definitions/kind"
        },
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "version": {
          "$ref": "#/definitions/semver"
        },
        "minAppVersion": {
          "$ref": "#/definitions/minAppVersion"
        },
        "displayName": {
          "$ref": "#/definitions/label"
        },
        "description": {
          "$ref": "#/definitions/description"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/definitions/label"
            },
            "url": {
              "$ref": "#/definitions/httpsUrl"
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 254
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9.+ ()-]+$"
        },
        "homepage": {
          "$ref": "#/definitions/httpsUrl"
        },
        "icon": {
          "$ref": "#/definitions/iconPath"
        },
        "platforms": {
          "$ref": "#/definitions/platforms"
        },
        "payload": {
          "type": "object"
        },
        "hostProtocol": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plugin"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/pluginPayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent-plugin"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/agentPluginPayload"
              },
              "hostProtocol": false
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mcp"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/mcpPayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "skill"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/skillPayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/agentPayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "theme"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/themePayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "font"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/fontPayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "language"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/languagePayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "provider"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/providerPayload"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "messaging-connection"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/definitions/messagingConnectionPayload"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "kind": {
      "enum": [
        "plugin",
        "agent-plugin",
        "mcp",
        "skill",
        "agent",
        "theme",
        "font",
        "language",
        "provider",
        "messaging-connection"
      ]
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "packageName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^(?!.*--)[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/label"
        },
        "url": {
          "$ref": "#/definitions/httpsUrl"
        }
      }
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "downloadUrl": {
      "description": "A catalog-supplied release or archive download. Plain http is accepted: the sha256 pin, read over the source's own transport, fixes the bytes (design §18.2.3).",
      "type": "string",
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https?://[^\\s]+$"
    },
    "repoPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?!(?:.*/)?\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
    },
    "iconPath": {
      "allOf": [
        {
          "$ref": "#/definitions/repoPath"
        },
        {
          "type": "string",
          "pattern": "\\.(?:png|jpg|jpeg|webp)$"
        }
      ]
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "darwin",
          "win32",
          "linux"
        ]
      }
    },
    "pluginAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "requires"
      ],
      "properties": {
        "capabilities": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/capabilities"
        },
        "networkAccess": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/networkAccess"
        },
        "hostSecrets": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/hostSecrets"
        },
        "pluginAccess": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/pluginAccess"
        },
        "auth": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/auth"
        },
        "requires": {
          "allOf": [
            {
              "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/requires"
            },
            {
              "type": "object",
              "required": [
                "minAppVersion"
              ]
            }
          ]
        },
        "dependencies": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/dependencies"
        },
        "sandbox": {
          "$ref": "https://sdk.former-site.invalid/schemas/plugin.schema.json#/properties/extensions/properties/ai.agent-connector.ave/properties/sandbox"
        }
      }
    },
    "pluginArtifactPins": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9._-]+$"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            },
            "asset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            },
            "url": {
              "$ref": "#/definitions/downloadUrl"
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "$ref": "#/definitions/downloadUrl"
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            }
          }
        },
        "tree": {
          "$ref": "#/definitions/repoPath"
        }
      }
    },
    "pluginPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "artifact"
      ],
      "properties": {
        "authority": {
          "$ref": "#/definitions/pluginAuthority"
        },
        "artifact": {
          "$ref": "#/definitions/pluginArtifactPins"
        }
      }
    },
    "mcpPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "server"
          ],
          "properties": {
            "server": {
              "$ref": "#/definitions/mcpServer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "serverJson"
          ],
          "properties": {
            "serverJson": {
              "const": "server.json"
            },
            "select": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "package": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "remote": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                }
              }
            }
          }
        }
      ]
    },
    "mcpServer": {
      "description": "The host's MCP runtime spec (src/plugins/mcp-runtime-spec.ts) without the fields a package may not decide for itself (private-network access, OAuth client metadata).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "command"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "args": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "env": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "auth": {
              "enum": [
                "none",
                "api-key",
                "sso"
              ]
            },
            "apiKeyEnv": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "url"
          ],
          "properties": {
            "transport": {
              "const": "http"
            },
            "url": {
              "$ref": "#/definitions/httpsUrl"
            },
            "auth": {
              "enum": [
                "none",
                "api-key",
                "sso",
                "oauth"
              ]
            },
            "apiKeyHeader": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[!#$%&'*+\\-.^_`|~0-9A-Za-z]+$"
            }
          }
        }
      ]
    },
    "languagePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "entry",
        "messages"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
        },
        "entry": {
          "const": "language.json"
        },
        "messages": {
          "const": "messages.json"
        }
      }
    },
    "skillPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "const": "SKILL.md"
        }
      }
    },
    "agentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "const": "AGENTS.md"
        }
      }
    },
    "themePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "const": "theme.json"
        }
      }
    },
    "fontPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "const": "font.json"
        }
      }
    },
    "providerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "const": "provider.json"
        }
      }
    },
    "messagingConnectionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "const": "connection.json"
        }
      }
    },
    "agentPluginComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "mcpServers",
        "prompts",
        "agents",
        "routineTemplates",
        "hooks"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hasScripts",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "hasScripts": {
                "type": "boolean"
              },
              "digest": {
                "$ref": "#/definitions/sha256"
              }
            }
          }
        },
        "mcpServers": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "transport",
                  "command",
                  "cwd",
                  "digest"
                ],
                "properties": {
                  "transport": {
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  },
                  "env": {
                    "type": "object",
                    "maxProperties": 64,
                    "propertyNames": {
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "auth": {
                    "const": "api-key"
                  },
                  "apiKeyEnv": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "digest": {
                    "$ref": "#/definitions/sha256"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "transport",
                  "url",
                  "digest"
                ],
                "properties": {
                  "transport": {
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "headers": {
                    "type": "object",
                    "maxProperties": 64,
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  },
                  "auth": {
                    "const": "api-key"
                  },
                  "apiKeyHeader": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "digest": {
                    "$ref": "#/definitions/sha256"
                  }
                }
              }
            ]
          }
        },
        "mcpAuth": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auth"
            ],
            "properties": {
              "auth": {
                "const": "api-key"
              },
              "apiKeyEnv": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "apiKeyHeader": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "prompts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "digest": {
                "$ref": "#/definitions/sha256"
              },
              "kind": {
                "enum": [
                  "template",
                  "persona"
                ]
              }
            }
          }
        },
        "agents": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "digest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "digest": {
                "$ref": "#/definitions/sha256"
              }
            }
          }
        },
        "routineTemplates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "trigger",
              "execution",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "trigger": {
                "enum": [
                  "schedule",
                  "shutdown"
                ]
              },
              "schedule": {
                "type": "object",
                "additionalProperties": false,
                "anyOf": [
                  { "required": ["at"] },
                  { "required": ["repeat"] }
                ],
                "properties": {
                  "at": { "type": "string", "format": "date-time" },
                  "repeat": {
                    "oneOf": [
                      { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["none", "daily", "weekly", "monthly"] } } },
                      { "type": "object", "additionalProperties": false, "required": ["kind", "intervalMs"], "properties": { "kind": { "const": "interval" }, "intervalMs": { "type": "number", "minimum": 60000 } } },
                      { "type": "object", "additionalProperties": false, "required": ["kind", "expression"], "properties": { "kind": { "const": "cron" }, "expression": { "type": "string", "minLength": 1 } } }
                    ]
                  }
                }
              },
              "execution": {
                "enum": [
                  "llm-session",
                  "notification-only"
                ]
              },
              "suggestedScope": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "digest": {
                "$ref": "#/definitions/sha256"
              }
            }
          }
        },
