++//! Durable deny intent and replayable ACL deltas in the protected session DB.
++//!
++//! A desired-set transaction records both durable rows and live holder edges,
++//! then journals only objects whose effective permissions changed. The journal
++//! is removed after the ACL writer succeeds, so recovery retries interrupted
++//! additions and removals without rewriting completed objects.
++
++use anyhow::{Context, Result, bail};
++use rusqlite::{Connection, OptionalExtension, params};
++use std::collections::BTreeMap;
++
++use crate::acl::SbAce;
++use crate::path_id::{self, FileId};
++use crate::state_db::{self, AceWitness, Locked};
++
++pub(crate) const SCHEMA: &str = r#"
++CREATE TABLE IF NOT EXISTS persistent_deny_principal (
++  singleton INTEGER PRIMARY KEY CHECK(singleton = 1),
++  sandbox_sid TEXT NOT NULL
++);
++CREATE TABLE IF NOT EXISTS persistent_deny_owners (
++  owner TEXT PRIMARY KEY,
++  sandbox_sid TEXT NOT NULL
++);
++CREATE TABLE IF NOT EXISTS persistent_deny_formats (
++  owner TEXT NOT NULL REFERENCES persistent_deny_owners(owner) ON DELETE CASCADE,
++  canonical_path TEXT NOT NULL,
++  kind TEXT NOT NULL,
++  file_id BLOB NOT NULL,
++  writer_format INTEGER NOT NULL,
++  PRIMARY KEY(owner, canonical_path, kind)
++);
++CREATE TABLE IF NOT EXISTS persistent_denies (
++  owner TEXT NOT NULL REFERENCES persistent_deny_owners(owner) ON DELETE CASCADE,
++  canonical_path TEXT NOT NULL,
++  kind TEXT NOT NULL,
++  file_id BLOB NOT NULL,
++  mask TEXT NOT NULL,
++  PRIMARY KEY(owner, canonical_path, kind)
++);
++CREATE TABLE IF NOT EXISTS pending_retired_grants (
++  canonical_path TEXT NOT NULL,
++  file_id BLOB NOT NULL,
++  sandbox_sid TEXT NOT NULL,
++  attempted INTEGER NOT NULL DEFAULT 0,
++  tree_write INTEGER NOT NULL DEFAULT 0,
++  completed INTEGER NOT NULL DEFAULT 0,
++  PRIMARY KEY(canonical_path, file_id, sandbox_sid)
++);
++CREATE TABLE IF NOT EXISTS pending_deny_acl (
++  canonical_path TEXT NOT NULL,
++  file_id BLOB NOT NULL,
++  sandbox_sid TEXT NOT NULL,
++  attempted INTEGER NOT NULL DEFAULT 0,
++  tree_write INTEGER NOT NULL DEFAULT 0,
++  PRIMARY KEY(canonical_path, file_id, sandbox_sid)
++);
++"#;
++
++#[derive(Clone, Debug, PartialEq, Eq)]
++struct Target {
++    path: String,
++    file_id: Vec<u8>,
++    ace: SbAce,
++}
++
++type Object = (String, Vec<u8>);
++type Effective = BTreeMap<Object, BTreeMap<String, String>>;
++
++fn validate_owner(owner: &str) -> Result<()> {
++    if owner.is_empty()
++        || owner.len() > 64
++        || !owner
++            .bytes()
++            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == b'-')
++    {
++        bail!("invalid persistent deny owner");
++    }
++    Ok(())
++}
