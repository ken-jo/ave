++/// The administrator-owned setup record, not a caller or saved DB SID,
++/// supplies the only principal that can receive an ACL mutation.
++pub(crate) fn trusted_sid() -> Result<String> {
++    let setup = crate::install::read_setup()?.context("sandbox setup is unavailable")?;
++    let actual = crate::sid::lookup_account_sid(&setup.sandbox_user)?;
++    if actual != setup.sandbox_user_sid
++        || actual == crate::sid::current_user_sid()?
++        || !crate::sam::is_member_of(&setup.sandbox_group_sid, &actual)?
++    {
++        bail!("sandbox principal validation failed");
++    }
++    Ok(actual)
++}
++
++fn retire_old_principals_with(
++    conn: &Connection,
++    current: &str,
++    absent: impl Fn(&str) -> Result<bool>,
++    alive: impl Fn(u32, i64) -> bool,
++    mut remove_grant: impl FnMut(&str, &[u8], &str, bool, &mut dyn FnMut() -> Result<()>) -> Result<()>,
++) -> Result<()> {
++    let old: Vec<String> = state_db::query_vec(
++        conn,
++        "SELECT sandbox_sid FROM persistent_deny_owners UNION SELECT sandbox_sid FROM pending_deny_acl UNION SELECT sandbox_sid FROM persistent_deny_principal UNION SELECT sandbox_sid FROM pending_retired_grants",
++        [],
++        |r| r.get(0),
++    )?;
++    let mixed = old.iter().any(|sid| sid == current);
++    let stale: Vec<_> = old.into_iter().filter(|sid| sid != current).collect();
++    for sid in &stale {
++        if !absent(sid)? {
++            bail!(
++                "previous sandbox principal is still mapped or unverifiable; persistent denies retained"
++            );
++        }
++    }
++    if stale.is_empty() {
++        return Ok(());
++    }
++    if mixed {
++        bail!("mixed sandbox principals require explicit cleanup; all state retained");
++    }
++    let brokers: Vec<(u32, i64)> = state_db::query_vec(
++        conn,
++        "SELECT pid, process_create_time FROM brokers",
++        [],
++        |r| Ok((r.get(0)?, r.get(1)?)),
++    )?;
++    if brokers
++        .into_iter()
++        .any(|(pid, created)| alive(pid, created))
++    {
++        bail!("previous sandbox holder is live or unverifiable; principal state retained");
++    }
++    let grants: Vec<(String, Vec<u8>)> = state_db::query_vec(
++        conn,
++        "SELECT canonical_path, file_id FROM working_aces WHERE kind = 'grant'",
++        [],
++        |r| Ok((r.get(0)?, r.get(1)?)),
++    )?;
++    for sid in &stale {
++        for (path, id) in &grants {
++            conn.execute("INSERT OR IGNORE INTO pending_retired_grants(canonical_path, file_id, sandbox_sid) VALUES (?1, ?2, ?3)",
++                params![path, id, sid])?;
++        }
++    }
++    let pending: Vec<(String, Vec<u8>, String, bool)> = state_db::query_vec(
++        conn,
++        "SELECT canonical_path, file_id, sandbox_sid, tree_write FROM pending_retired_grants WHERE completed = 0 ORDER BY canonical_path",
++        [],
++        |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
++    )?;
++    for (path, id, old_sid, tree_repair) in pending {
++        if !stale.contains(&old_sid) {
++            bail!("retired grant principal does not match retired state");
++        }
++        conn.execute("UPDATE pending_retired_grants SET attempted = 1 WHERE canonical_path = ?1 AND file_id = ?2 AND sandbox_sid = ?3",
++            params![path, id, old_sid])?;
++        let mut before_tree_write = || {
++            conn.execute("UPDATE pending_retired_grants SET tree_write = 1 WHERE canonical_path = ?1 AND file_id = ?2 AND sandbox_sid = ?3",
++                params![path, id, old_sid])?;
++            Ok(())
++        };
++        remove_grant(&path, &id, &old_sid, tree_repair, &mut before_tree_write)
++            .context("retired sandbox grant cleanup remains pending")?;
++        conn.execute("UPDATE pending_retired_grants SET completed = 1 WHERE canonical_path = ?1 AND file_id = ?2 AND sandbox_sid = ?3",
++            params![path, id, old_sid])?;
++    }
++    let tx = conn.unchecked_transaction()?;
++    for sid in &stale {
++        tx.execute(
++            "DELETE FROM persistent_deny_owners WHERE sandbox_sid = ?1",
++            [sid],
++        )?;
++        tx.execute("DELETE FROM pending_deny_acl WHERE sandbox_sid = ?1", [sid])?;
++        tx.execute(
++            "DELETE FROM pending_retired_grants WHERE sandbox_sid = ?1",
++            [sid],
++        )?;
++    }
++    // The former account is absent and every recorded holder is dead. Keep
++    // conservative old deny ACEs; never reuse path-keyed rows for a replacement.
++    tx.execute("DELETE FROM ace_holders", [])?;
++    tx.execute("DELETE FROM working_aces", [])?;
++    tx.execute("DELETE FROM brokers", [])?;
++    tx.execute("DELETE FROM persistent_deny_principal", [])?;
++    tx.execute(
++        "INSERT INTO persistent_deny_principal VALUES (1, ?1)",
++        [current],
++    )?;
++    tx.commit()?;
++    eprintln!(
++        "srt-win: retired absent sandbox principal state after holder exit; old deny ACEs retained"
++    );
++    Ok(())
++}
