++/// Fold only rows for this verified principal and this exact object identity.
++pub(crate) fn rows_at(
++    conn: &Connection,
++    path: &str,
++    id: &[u8],
++    sid: &str,
++) -> Result<Vec<(String, String)>> {
++    let rows = state_db::query_vec(
++        conn,
++        "SELECT d.kind, d.mask FROM persistent_denies d JOIN persistent_deny_owners o ON o.owner = d.owner \
++         WHERE d.canonical_path = ?1 AND d.file_id = ?2 AND o.sandbox_sid = ?3",
++        params![path, id, sid],
++        |r| Ok((r.get(0)?, r.get(1)?)),
++    )?;
++    Ok(rows)
++}
