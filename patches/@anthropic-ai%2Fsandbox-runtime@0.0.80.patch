++fn reconcile_rows(
++    conn: &Connection,
++    pid: u32,
++    owner: &str,
++    sid: &str,
++    targets: &[Target],
++) -> Result<()> {
++    validate_owner(owner)?;
++    let before = snapshot(conn)?;
++    let mut adoptions = Vec::new();
++    for target in targets {
++        let completed: Option<String> = conn.prepare_cached(
++            "SELECT d.mask FROM persistent_denies d JOIN persistent_deny_owners o ON o.owner = d.owner JOIN persistent_deny_formats f ON f.owner = d.owner AND f.canonical_path = d.canonical_path AND f.kind = d.kind AND f.file_id = d.file_id \
++             WHERE d.owner = ?1 AND d.canonical_path = ?2 AND d.kind = ?3 AND d.file_id = ?4 AND o.sandbox_sid = ?5 AND f.writer_format = ?6")?
++            .query_row(params![owner, target.path, target.ace.kind(), target.file_id, sid, state_db::ACL_WRITER_FORMAT], |row| row.get(0)).optional()?;
++        // A completed durable floor is physical proof, unlike working labels.
++        // Read can cover a weaker Write request; Write can never cover Read.
++        let verified = completed
++            .map(|mask| SbAce::parse(target.ace.kind(), &mask))
++            .transpose()?
++            .is_some_and(|floor| floor.max(target.ace) == floor);
++        if !verified {
++            adoptions.push((target.path.clone(), target.file_id.clone()));
++        }
++    }
++
++    // A live hold refers to the original file object. Do not overwrite its
++    // identity with a replacement at the same spelling.
++    for target in targets {
++        let ids: Vec<Vec<u8>> = state_db::query_vec(
++            conn,
++            "SELECT file_id FROM working_aces WHERE canonical_path = ?1",
++            [&target.path],
++            |r| r.get(0),
++        )?;
++        if ids.iter().any(|id| id != &target.file_id) {
++            bail!("persistent deny target was substituted while still held");
++        }
++    }
++    let tx = conn.unchecked_transaction()?;
++    tx.execute("INSERT INTO persistent_deny_principal VALUES (1, ?1) ON CONFLICT(singleton) DO UPDATE SET sandbox_sid = excluded.sandbox_sid", [sid])?;
++    tx.execute(
++        "INSERT INTO persistent_deny_owners(owner, sandbox_sid) VALUES (?1, ?2) \
++        ON CONFLICT(owner) DO UPDATE SET sandbox_sid = excluded.sandbox_sid",
++        params![owner, sid],
++    )?;
++    tx.execute("DELETE FROM persistent_denies WHERE owner = ?1", [owner])?;
++    for target in targets {
++        tx.execute(
++            "INSERT INTO persistent_denies(owner, canonical_path, kind, file_id, mask) \
++            VALUES (?1, ?2, ?3, ?4, ?5)",
++            params![
++                owner,
++                target.path,
++                target.ace.kind(),
++                target.file_id,
++                target.ace.as_str()
++            ],
++        )?;
++        let held: Option<String> = tx
++            .query_row(
++                "SELECT want_mask FROM ace_holders \
++            WHERE canonical_path = ?1 AND kind = ?2 AND pid = ?3",
++                params![target.path, target.ace.kind(), pid as i64],
++                |r| r.get(0),
++            )
++            .optional()?;
++        let held = held
++            .map(|mask| SbAce::parse(target.ace.kind(), &mask))
++            .transpose()?
++            .map_or(target.ace, |ace| ace.max(target.ace));
++        tx.execute(
++            "INSERT INTO ace_holders(canonical_path, kind, pid, want_mask) VALUES (?1, ?2, ?3, ?4) \
++            ON CONFLICT(canonical_path, kind, pid) DO UPDATE SET want_mask = excluded.want_mask",
++            params![target.path, target.ace.kind(), pid as i64, held.as_str()],
++        )?;
++        let masks: Vec<String> = state_db::query_vec(
++            &tx,
++            "SELECT want_mask FROM ace_holders WHERE canonical_path = ?1 AND kind = ?2",
++            params![target.path, target.ace.kind()],
++            |r| r.get(0),
++        )?;
++        let mut effective = target.ace;
++        for mask in masks {
++            effective = effective.max(SbAce::parse(target.ace.kind(), &mask)?);
++        }
++        tx.execute("INSERT INTO working_aces(canonical_path, kind, file_id, mask) VALUES (?1, ?2, ?3, ?4) \
++            ON CONFLICT(canonical_path, kind) DO UPDATE SET file_id = excluded.file_id, mask = excluded.mask",
++            params![target.path, target.ace.kind(), target.file_id, effective.as_str()])?;
++    }
++    tx.execute("DELETE FROM persistent_deny_formats WHERE owner = ?1 AND NOT EXISTS \
++        (SELECT 1 FROM persistent_denies d WHERE d.owner = persistent_deny_formats.owner \
++         AND d.canonical_path = persistent_deny_formats.canonical_path \
++         AND d.kind = persistent_deny_formats.kind AND d.file_id = persistent_deny_formats.file_id)", [owner])?;
++    journal_delta(&tx, &before, sid)?;
++
++    // Opaque working labels do not establish physical masks or flags. First
++    // adoption must reach the identity-aware writer even when labels match.
++    for (path, id) in adoptions {
++        queue_pending(&tx, &path, &id, sid)?;
++    }
++    tx.commit()?;
++    Ok(())
++}
