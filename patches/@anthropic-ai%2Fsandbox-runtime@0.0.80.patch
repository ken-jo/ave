++fn create_owned_junction(path: &Path, target: &Path) {
++    use srt_win::util::OwnedHandle;
++    use windows::Win32::Storage::FileSystem::{
++        CreateFileW, FILE_FLAG_BACKUP_SEMANTICS, FILE_FLAG_OPEN_REPARSE_POINT, FILE_SHARE_DELETE,
++        FILE_SHARE_READ, FILE_SHARE_WRITE, OPEN_EXISTING,
++    };
++    use windows::Win32::System::IO::DeviceIoControl;
++    use windows::Win32::System::SystemServices::IO_REPARSE_TAG_MOUNT_POINT;
++    const SET_REPARSE_POINT: u32 = 0x0009_00a4;
++    std::fs::create_dir(path).unwrap();
++    let print = srt_win::path_id::strip_extended_prefix(target.to_str().unwrap());
++    let substitute: Vec<u16> = format!(r"\??\{print}").encode_utf16().collect();
++    let print: Vec<u16> = print.encode_utf16().collect();
++    let path_bytes = (substitute.len() + 1 + print.len() + 1) * 2;
++    let data_length = 8 + path_bytes;
++    let mut buffer = Vec::with_capacity(8 + data_length);
++    buffer.extend_from_slice(&IO_REPARSE_TAG_MOUNT_POINT.to_le_bytes());
++    for value in [
++        data_length as u16,
++        0,
++        0,
++        (substitute.len() * 2) as u16,
++        ((substitute.len() + 1) * 2) as u16,
++        (print.len() * 2) as u16,
++    ] {
++        buffer.extend_from_slice(&value.to_le_bytes());
++    }
++    for value in substitute
++        .iter()
++        .chain([0].iter())
++        .chain(print.iter())
++        .chain([0].iter())
++    {
++        buffer.extend_from_slice(&value.to_le_bytes());
++    }
++    let name = wstr(path.to_str().unwrap());
++    let handle = OwnedHandle(
++        unsafe {
++            CreateFileW(
++                pcwstr(&name),
++                Mask::FILE_GENERIC_WRITE.bits(),
++                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
++                None,
++                OPEN_EXISTING,
++                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT,
++                None,
++            )
++        }
++        .unwrap(),
++    );
++    let mut returned = 0;
++    unsafe {
++        DeviceIoControl(
++            handle.0,
++            SET_REPARSE_POINT,
++            Some(buffer.as_ptr().cast()),
++            buffer.len() as u32,
++            None,
++            0,
++            Some(&mut returned),
++            None,
++        )
++    }
++    .unwrap();
++    assert_eq!(
++        std::fs::canonicalize(path).unwrap(),
++        std::fs::canonicalize(target).unwrap()
++    );
++}
