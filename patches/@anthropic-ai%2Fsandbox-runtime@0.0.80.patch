++/// A failed best-effort relocation is not proof of deletion. Confirm absence
++/// with an identity open so disconnected volumes and denied metadata remain
++/// retryable instead of silently discarding a removal intent.
++fn confirm_object_absent(expected: FileId) -> Result<bool> {
++    use windows::Win32::Storage::FileSystem::{
++        CreateFileW, ExtendedFileIdType, FILE_FLAG_BACKUP_SEMANTICS, FILE_ID_128,
++        FILE_ID_DESCRIPTOR, FILE_ID_DESCRIPTOR_0, FILE_SHARE_DELETE, FILE_SHARE_READ,
++        FILE_SHARE_WRITE, OPEN_EXISTING, OpenFileById,
++    };
++    for drive in b'A'..=b'Z' {
++        let root = format!(r"\\?\{}:\", drive as char);
++        let Ok(id) = path_id::capture_file_id(&root) else {
++            continue;
++        };
++        if id.volume_serial != expected.volume_serial {
++            continue;
++        }
++        let wide = crate::util::wstr(&root);
++        let volume = crate::util::OwnedHandle(
++            unsafe {
++                CreateFileW(
++                    crate::util::pcwstr(&wide),
++                    0,
++                    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
++                    None,
++                    OPEN_EXISTING,
++                    FILE_FLAG_BACKUP_SEMANTICS,
++                    None,
++                )
++            }
++            .context("open pending deny volume")?,
++        );
++        let descriptor = FILE_ID_DESCRIPTOR {
++            dwSize: std::mem::size_of::<FILE_ID_DESCRIPTOR>() as u32,
++            Type: ExtendedFileIdType,
++            Anonymous: FILE_ID_DESCRIPTOR_0 {
++                ExtendedFileId: FILE_ID_128 {
++                    Identifier: expected.id128,
++                },
++            },
++        };
++        return match unsafe {
++            OpenFileById(
++                volume.raw(),
++                &descriptor,
++                0,
++                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
++                None,
++                FILE_FLAG_BACKUP_SEMANTICS,
++            )
++        } {
++            Ok(handle) => {
++                drop(crate::util::OwnedHandle(handle));
++                Ok(false)
++            }
++            Err(error) => {
++                let error = anyhow::Error::from(error);
++                if path_id::is_not_found(&error) {
++                    Ok(true)
++                } else {
++                    Err(error).context("verify pending deny object absence")
++                }
++            }
++        };
++    }
++    bail!("pending deny object volume is unavailable");
++}
++
++fn resolve_pending_object(path: &str, bytes: &[u8]) -> Result<Option<String>> {
++    let expected = FileId::from_bytes(bytes)?;
++    let actual = match path_id::capture_file_id(path) {
++        Ok(id) if id == expected => Some(path.to_owned()),
++        Ok(_) => path_id::locate_by_file_id(&expected),
++        Err(error) if path_id::is_not_found(&error) => path_id::locate_by_file_id(&expected),
++        Err(error) => return Err(error).context("open pending ACL target"),
++    };
++    if actual.is_none() && !confirm_object_absent(expected)? {
++        bail!("pending ACL object could not be relocated");
++    }
++    if let Some(actual) = &actual
++        && path_id::capture_file_id(actual)? != expected
++    {
++        bail!("pending ACL target identity changed");
++    }
++    Ok(actual)
++}
++
++pub(crate) fn apply_pending(conn: &Connection, sid: &str) -> Result<Vec<String>> {
++    state_db::ensure_writer_compatibility(conn)?;
++    replay_with(conn, sid, |path, bytes, repair, before_tree_write| {
++        if let Some(actual) = resolve_pending_object(path, bytes)? {
++            state_db::recompose_identity(
++                conn,
++                path,
++                &actual,
++                bytes,
++                sid,
++                repair,
++                before_tree_write,
++            )?;
++        }
++        Ok(())
++    })
++}
++
++pub(crate) fn recover(conn: &Connection) -> Result<()> {
++    state_db::ensure_writer_compatibility(conn)?;
++    let present: bool = conn.query_row(
++        "SELECT EXISTS(SELECT 1 FROM persistent_deny_owners) \
++        OR EXISTS(SELECT 1 FROM pending_deny_acl) OR EXISTS(SELECT 1 FROM pending_retired_grants) OR (EXISTS(SELECT 1 FROM persistent_deny_principal) AND EXISTS(SELECT 1 FROM working_aces))",
++        [],
++        |r| r.get(0),
++    )?;
++    if !present {
++        return Ok(());
++    }
++    let sid = trusted_sid()?;
++    prepare_principal(conn, &sid)?;
++    apply_pending(conn, &sid)?;
++    Ok(())
++}
