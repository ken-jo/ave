++    let source = wstr(source.to_str().unwrap());
++    let destination = wstr(destination.to_str().unwrap());
++    unsafe {
++        MoveFileExW(
++            pcwstr(&source),
++            pcwstr(&destination),
++            MOVEFILE_REPLACE_EXISTING,
++        )
++    }
++    .map_err(|error| std::io::Error::from_raw_os_error(error.code().0 & 0xffff))
