++pub(crate) fn reconcile(
++    db: &Locked,
++    owner: &str,
++    supplied_sid: &str,
++    inputs: &[(String, SbAce)],
++) -> Result<(Vec<AceWitness>, usize)> {
++    validate_owner(owner)?;
++    let sid = trusted_sid()?;
++    if supplied_sid != sid {
++        bail!("supplied sandbox principal does not match setup");
++    }
++    prepare_principal(&db.conn, &sid)?;
++    let targets = targets_with(inputs, path_id::capture_id_and_links)?;
++    db.register_broker()?;
++    let before = snapshot(&db.conn)?;
++    let holds: Vec<(String, String)> = state_db::query_vec(
++        &db.conn,
++        "SELECT canonical_path, kind FROM ace_holders WHERE pid = ?1",
++        [db.holder_pid.0],
++        |r| Ok((r.get(0)?, r.get(1)?)),
++    )?;
++    reconcile_rows(&db.conn, db.holder_pid.0, owner, &sid, &targets)?;
++    apply_pending(&db.conn, &sid)?;
++    Ok((
++        targets
++            .into_iter()
++            .map(|t| AceWitness {
++                already: before
++                    .get(&(t.path.clone(), t.file_id))
++                    .is_some_and(|kinds| kinds.contains_key(t.ace.kind())),
++                holder_added: !holds.contains(&(t.path.clone(), t.ace.kind().to_owned())),
++                canon: t.path,
++                ace: t.ace,
++                _sealed: (),
++            })
++            .collect(),
++        0,
++    ))
++}
++
++fn forget_rows(conn: &Connection, owner: Option<&str>, sid: &str) -> Result<()> {
++    if let Some(owner) = owner {
++        validate_owner(owner)?;
++    }
++    let before = snapshot(conn)?;
++    let tx = conn.unchecked_transaction()?;
++    match owner {
++        Some(owner) => {
++            tx.execute(
++                "DELETE FROM persistent_deny_owners WHERE owner = ?1",
++                [owner],
++            )?;
++        }
++        None => {
++            tx.execute("DELETE FROM persistent_deny_owners", [])?;
++        }
++    }
++    journal_delta(&tx, &before, sid)?;
++    tx.commit()?;
++    Ok(())
++}
++
++pub(crate) fn forget(db: &Locked, owner: Option<&str>) -> Result<Vec<(String, String)>> {
++    let present: bool = db.conn.query_row("SELECT EXISTS(SELECT 1 FROM persistent_deny_owners) OR EXISTS(SELECT 1 FROM pending_deny_acl) OR EXISTS(SELECT 1 FROM pending_retired_grants)", [], |r| r.get(0))?;
++    if !present {
++        return Ok(Vec::new());
++    }
++    let sid = trusted_sid()?;
++    prepare_principal(&db.conn, &sid)?;
++    let paths: Vec<String> = state_db::query_vec(
++        &db.conn,
++        "SELECT DISTINCT canonical_path FROM persistent_denies WHERE ?1 IS NULL OR owner = ?1",
++        [owner],
++        |r| r.get(0),
++    )?;
++    forget_rows(&db.conn, owner, &sid)?;
++    apply_pending(&db.conn, &sid)?;
++    let after = snapshot(&db.conn)?;
++    Ok(paths
++        .into_iter()
++        .map(|path| {
++            let held = after.keys().any(|(p, _)| p == &path);
++            (path, if held { "stillHeld" } else { "revoked" }.to_owned())
++        })
++        .collect())
++}
