++fn replay_with(
++    conn: &Connection,
++    sid: &str,
++    mut write: impl FnMut(&str, &[u8], bool, &mut dyn FnMut() -> Result<()>) -> Result<()>,
++) -> Result<Vec<String>> {
++    let pending: Vec<(String, Vec<u8>, String, bool)> = state_db::query_vec(
++        conn,
++        "SELECT canonical_path, file_id, sandbox_sid, tree_write FROM pending_deny_acl ORDER BY canonical_path",
++        [],
++        |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
++    )?;
++    let mut out = Vec::new();
++    let mut failures = Vec::new();
++    for (path, id, recorded_sid, tree_repair) in pending {
++        if recorded_sid != sid {
++            bail!("pending deny principal does not match trusted sandbox principal");
++        }
++        // An attempted local write does not authorize tree propagation. Only
++        // the pinned writer's callback can record an actual tree commit intent.
++        conn.execute("UPDATE pending_deny_acl SET attempted = 1 WHERE canonical_path = ?1 AND file_id = ?2 AND sandbox_sid = ?3",
++            params![path, id, sid])?;
++        let mut before_tree_write = || {
++            conn.execute("UPDATE pending_deny_acl SET tree_write = 1 WHERE canonical_path = ?1 AND file_id = ?2 AND sandbox_sid = ?3",
++                params![path, id, sid])?;
++            Ok(())
++        };
++        match write(&path, &id, tree_repair, &mut before_tree_write) {
++            Ok(()) => {
++                let tx = conn.unchecked_transaction()?;
++                tx.execute("INSERT INTO persistent_deny_formats(owner, canonical_path, kind, file_id, writer_format) \
++                    SELECT d.owner, d.canonical_path, d.kind, d.file_id, ?4 \
++                    FROM persistent_denies d JOIN persistent_deny_owners o ON o.owner = d.owner \
++                    WHERE d.canonical_path = ?1 AND d.file_id = ?2 AND o.sandbox_sid = ?3 \
++                    ON CONFLICT(owner, canonical_path, kind) DO UPDATE SET file_id = excluded.file_id, writer_format = excluded.writer_format",
++                    params![path, id, sid, state_db::ACL_WRITER_FORMAT])?;
++                tx.execute("DELETE FROM pending_deny_acl WHERE canonical_path = ?1 AND file_id = ?2 AND sandbox_sid = ?3",
++                    params![path, id, sid])?;
++                tx.commit()?;
++                out.push(path);
++            }
++            Err(error) => failures.push(format!("{path}: {error:#}")),
++        }
++    }
++    if !failures.is_empty() {
++        bail!(
++            "persistent deny ACL changes pending: {}",
++            failures.join("; ")
++        );
++    }
++    Ok(out)
++}
