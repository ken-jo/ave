++/// Check caller-supplied principals whenever durable state participates in an
++/// ordinary stamp or release operation.
++pub(crate) fn validate_supplied(conn: &Connection, sid: &str) -> Result<()> {
++    let present: bool = conn.query_row(
++        "SELECT EXISTS(SELECT 1 FROM persistent_deny_owners) \
++        OR EXISTS(SELECT 1 FROM pending_deny_acl) OR EXISTS(SELECT 1 FROM pending_retired_grants) OR EXISTS(SELECT 1 FROM persistent_deny_principal)",
++        [],
++        |r| r.get(0),
++    )?;
++    if present {
++        if trusted_sid()? != sid {
++            bail!("supplied sandbox principal does not match setup");
++        }
++        prepare_principal(conn, sid)?;
++    }
++    Ok(())
++}
++
++/// Effective ACE signature for avoiding writes when only holder edges change.
++pub(crate) fn signature(
++    conn: &Connection,
++    path: &str,
++    id: &[u8],
++) -> Result<Option<BTreeMap<String, String>>> {
++    let rows: Vec<(String, String)> = state_db::query_vec(
++        conn,
++        "SELECT kind, mask FROM working_aces WHERE canonical_path = ?1 AND file_id = ?2 UNION ALL \
++         SELECT kind, mask FROM persistent_denies WHERE canonical_path = ?1 AND file_id = ?2",
++        params![path, id],
++        |r| Ok((r.get(0)?, r.get(1)?)),
++    )?;
++    let mut out: BTreeMap<String, String> = BTreeMap::new();
++    for (kind, mask) in rows {
++        let ace = SbAce::parse(&kind, &mask)?;
++        let ace = out
++            .get(&kind)
++            .map(|m| SbAce::parse(&kind, m))
++            .transpose()?
++            .map_or(ace, |prior| prior.max(ace));
++        out.insert(kind, ace.as_str().to_owned());
++    }
++    Ok((!out.is_empty()).then_some(out))
++}
++
++fn prepare_principal(conn: &Connection, sid: &str) -> Result<()> {
++    state_db::ensure_writer_compatibility(conn)?;
++    retire_old_principals_with(
++        conn,
++        sid,
++        |old| Ok(crate::sid::sid_account_exists(old)? == crate::sid::SidExistence::Unmapped),
++        state_db::is_process_alive,
++        |path, bytes, old_sid, repair, before_tree_write| {
++            if let Some(actual) = resolve_pending_object(path, bytes)? {
++                crate::acl::remove_sandbox_allow_aces_with_tree_intent(
++                    &actual,
++                    old_sid,
++                    bytes,
++                    repair,
++                    before_tree_write,
++                )?;
++            }
++            Ok(())
++        },
++    )
++}
++
++fn snapshot(conn: &Connection) -> Result<Effective> {
++    let rows: Vec<(String, Vec<u8>, String, String)> = state_db::query_vec(
++        conn,
++        "SELECT canonical_path, file_id, kind, mask FROM working_aces UNION ALL \
++         SELECT canonical_path, file_id, kind, mask FROM persistent_denies",
++        [],
++        |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
++    )?;
++    let mut out: Effective = BTreeMap::new();
++    for (path, file_id, kind, mask) in rows {
++        let kinds = out.entry((path, file_id)).or_default();
++        let ace = SbAce::parse(&kind, &mask)?;
++        let effective = match kinds.get(&kind) {
++            Some(prior) => SbAce::parse(&kind, prior)?.max(ace),
++            None => ace,
++        };
++        kinds.insert(kind, effective.as_str().to_owned());
++    }
++    Ok(out)
++}
++
++fn queue_pending(conn: &Connection, path: &str, id: &[u8], sid: &str) -> Result<()> {
++    conn.execute("INSERT OR IGNORE INTO pending_deny_acl(canonical_path, file_id, sandbox_sid) VALUES (?1, ?2, ?3)",
++        params![path, id, sid])?;
++    conn.execute(
++        "DELETE FROM persistent_deny_formats WHERE canonical_path = ?1 AND file_id = ?2",
++        params![path, id],
++    )?;
++    Ok(())
++}
++
++fn journal_delta(conn: &Connection, before: &Effective, sid: &str) -> Result<()> {
++    let after = snapshot(conn)?;
++    for object in before.keys().chain(after.keys()) {
++        if before.get(object) != after.get(object) {
++            queue_pending(conn, &object.0, &object.1, sid)?;
++        }
++    }
++    Ok(())
++}
++
++/// Record a live-holder transition in the durable lane before disk mutation.
++/// Caller keeps this in the same transaction as the working-row update.
++pub(crate) fn journal_holder_change(
++    conn: &Connection,
++    path: &str,
++    id: &[u8],
++    before: &Option<BTreeMap<String, String>>,
++    sid: &str,
++) -> Result<bool> {
++    let bound: bool = conn.query_row(
++        "SELECT EXISTS(SELECT 1 FROM persistent_deny_principal)",
++        [],
++        |r| r.get(0),
++    )?;
++    if !bound || before == &signature(conn, path, id)? {
++        return Ok(false);
++    }
++    queue_pending(conn, path, id, sid)?;
++    Ok(true)
++}
++
++fn targets_with(
++    inputs: &[(String, SbAce)],
++    capture: impl Fn(&str) -> Result<(FileId, u32, bool)>,
++) -> Result<Vec<Target>> {
++    let mut rows: BTreeMap<(String, String), Target> = BTreeMap::new();
++    for (path, ace) in inputs {
++        if matches!(ace, SbAce::Grant(_)) {
++            bail!("persistent deny cannot grant access");
++        }
++        let mut expanded = vec![(path.clone(), *ace)];
++        if matches!(ace, SbAce::Deny(_) | SbAce::DenyDelete)
++            && let Some(parent) = path_id::canonical_parent_of(path)
++        {
++            expanded.push((parent, SbAce::DenyFdc));
++        }
++        for (path, ace) in expanded {
++            let (id, links, is_dir) = capture(&path)?;
++            if matches!(ace, SbAce::Deny(_)) && !is_dir && links > 1 {
++                bail!("persistent deny refused on a file with multiple hardlinks");
++            }
++            let key = (path.clone(), ace.kind().to_owned());
++            let ace = rows.get(&key).map_or(ace, |prior| prior.ace.max(ace));
++            rows.insert(
++                key,
++                Target {
++                    path,
++                    file_id: id.as_bytes().to_vec(),
++                    ace,
++                },
++            );
++        }
++    }
++    Ok(rows.into_values().collect())
++}
