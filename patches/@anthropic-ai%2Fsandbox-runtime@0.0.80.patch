--- /dev/null
+++ b/dist/sandbox/proxy-failure.js
@@ -0,0 +1,30 @@
+import { sanitizeDenialReason } from './sandbox-violation-store.js';
+// Transport failures never authorize a connection and never claim a policy denial.
+export class ProxyTransportError extends Error {
+    constructor(kind, reason) {
+        super(sanitizeDenialReason(reason) || 'upstream transport failed');
+        this.name = 'ProxyTransportError';
+        this.kind = kind;
+        this.httpStatus = kind === 'timeout' ? 504 : 502;
+    }
+}
+export function transportFailure(error) {
+    if (error instanceof ProxyTransportError) return error;
+    const code = error?.code;
+    if (code === 'ERR_SRT_STALE_ROUTE')
+        return new ProxyTransportError('routing', 'upstream routing changed during the connection decision');
+    if (code === 'ETIMEDOUT' || code === 'ESOCKETTIMEDOUT')
+        return new ProxyTransportError('timeout', 'upstream connection timed out');
+    if (code === 'ENOTFOUND' || code === 'EAI_AGAIN')
+        return new ProxyTransportError('dns', 'destination name did not resolve');
+    return new ProxyTransportError('connect', 'upstream connection failed');
+}
+export function rawTransportFailure(failure) {
+    const phrase = failure.httpStatus === 504 ? 'Gateway Timeout' : 'Bad Gateway';
+    return `HTTP/1.1 ${failure.httpStatus} ${phrase}\r\nContent-Type: text/plain\r\nX-Proxy-Error: transport-${failure.kind}\r\nX-Proxy-Reason: ${failure.message}\r\nConnection: close\r\n\r\n${failure.message}\n`;
+}
+export function respondTransportFailure(res, failure) {
+    if (res.headersSent || res.destroyed) { res.destroy(); return; }
+    res.writeHead(failure.httpStatus, { 'Content-Type': 'text/plain', 'X-Proxy-Error': 'transport-' + failure.kind, 'X-Proxy-Reason': failure.message });
+    res.end(failure.message + '\n');
+}
